layer "Business Architecture" {

    // ==========================================
    // 1.0 Retail Banking Operations
    // ==========================================
    capability cap_retail_banking "Retail Banking Operations" {
        description "All customer-facing retail banking services"
        owner "VP Retail Banking"
        maturity "Managed"
        number "1.0"
        attr strategic_value "High"

        capability cap_lending "Consumer Lending" {
            description "End-to-end loan application and servicing capability"
            owner "Lending Product Lead"
            maturity "Defined"
            number "1.1"
            attr strategic_value "High"

            capability cap_credit_scoring "Automated Credit Scoring" {
                description "Real-time automated credit underwriting"
                owner "Risk Modeling Team"
                maturity "Optimizing"
                number auto
                attr strategic_value "Very-High"

                lifecycle {
                    phase Build start "2024-01-01" end "2024-09-01"
                    phase Run start "2024-09-02"
                }
                score {
                    business_value 8.8
                    tech_fit 9.0
                }
            }
        }

        capability cap_payments "Payments and Transfers" {
            description "Processing internal, domestic, and international transfers"
            owner "VP of Payments"
            maturity "Optimizing"
            number "1.2"
            attr strategic_value "High"

            capability cap_real_time_payments "Real-Time Payments" {
                description "Instant clearing and settlement"
                owner "Real-Time Rails Lead"
                maturity "Optimizing"
                number auto
                attr strategic_value "Very-High"
            }
        }
    }

    // ==========================================
    // 2.0 customer Service & Ops
    // ==========================================
    capability cap_customer_service "Customer Service & Ops" {
        description "Support operations and user lifecycle management"
        owner "VP Customer Operations"
        maturity "Defined"
        number "2.0"
        attr strategic_value "High"

        capability cap_onboarding "Digital Onboarding" {
            description "KYC/AML customer acquisition and digital verification"
            owner "Onboarding Product Manager"
            maturity "Initial"
            number "2.1"
            attr strategic_value "Very-High"

            score {
                business_value 8.0
                tech_fit 6.0
            }

            capability cap_identity_verification "Identity Verification (KYC)" {
                description "Document capture, liveness checks, and identity proofing against government records"
                owner "Identity Operations"
                maturity "Managed"
                number auto
                attr strategic_value "Very-High"
            }

            capability cap_account_provisioning "Account Provisioning" {
                description "Automated creation and configuration of new customer wallet accounts"
                owner "Onboarding Product Manager"
                maturity "Defined"
                number auto
                attr strategic_value "High"
            }
        }

        capability cap_customer_support "Customer Support Services" {
            description "Ticketing, chat support, and customer resolution"
            owner "Support Ops Director"
            maturity "Managed"
            number "2.2"
            attr strategic_value "Medium"

            capability cap_case_management "Case Management" {
                description "Tracking, prioritizing, and resolving customer service tickets end to end"
                owner "Support Ops Director"
                maturity "Managed"
                number auto
                attr strategic_value "Medium"
            }

            capability cap_live_chat_messaging "Live Chat & Messaging" {
                description "Real-time human and AI-assisted messaging channels for customer support"
                owner "Support Ops Director"
                maturity "Defined"
                number auto
                attr strategic_value "Medium"
            }

            capability cap_contact_center_ops "Contact Center Operations" {
                description "Phone-channel call routing, IVR self-service, and omnichannel ticket handling across voice, chat, and email"
                owner "Head of Contact Center Operations"
                maturity "Defined"
                number auto
                attr strategic_value "Medium"
            }
        }
    }

    // ==========================================
    // 3.0 Risk and Compliance Management
    // ==========================================
    capability cap_risk_compliance "Risk and Compliance Management" {
        description "Ensuring financial regulation adherence and security"
        owner "Chief Risk Officer"
        maturity "Defined"
        number "3.0"
        attr strategic_value "High"

        capability cap_fraud_detection "Real-Time Fraud Prevention" {
            description "Proactive machine learning fraud analysis"
            owner "Fraud Security Director"
            maturity "Optimizing"
            number "3.1"
            attr strategic_value "Very-High"

            score {
                business_value 8.7
                tech_fit 7.8
            }

            capability cap_transaction_scoring "Real-Time Transaction Scoring" {
                description "Streaming ML scoring of every transaction for fraud probability"
                owner "Fraud Security Director"
                maturity "Optimizing"
                number auto
                attr strategic_value "Very-High"
            }

            capability cap_fraud_case_investigation "Fraud Case Investigation" {
                description "Analyst and AI-assisted triage and investigation of flagged fraud cases"
                owner "Fraud Ops"
                maturity "Managed"
                number auto
                attr strategic_value "High"
            }
        }

        capability cap_aml_compliance "Anti-Money Laundering (AML)" {
            description "Transaction monitoring and regulatory reporting"
            owner "AML Compliance Lead"
            maturity "Managed"
            number "3.2"
            attr strategic_value "High"

            capability cap_sanctions_screening "Sanctions Screening" {
                description "Real-time screening of customers and counterparties against sanctions and watch lists"
                owner "AML Compliance Lead"
                maturity "Managed"
                number auto
                attr strategic_value "Very-High"
            }

            capability cap_sar "Suspicious Activity Reporting" {
                description "Preparation and regulatory filing of suspicious activity reports"
                owner "AML Compliance Lead"
                maturity "Defined"
                number auto
                attr strategic_value "High"
            }
        }

        capability cap_regulatory_reporting "Regulatory Reporting & Compliance" {
            description "Preparation, validation, and submission of mandated regulatory filings"
            owner "Head of Regulatory Affairs"
            maturity "Defined"
            number "3.3"
            attr strategic_value "High"

            capability cap_regulatory_filings_management "Regulatory Filings Management" {
                description "End-to-end lifecycle management of regulatory filings and submission deadlines"
                owner "Head of Regulatory Affairs"
                maturity "Defined"
                number auto
                attr strategic_value "High"
            }

            capability cap_compliance_policy_management "Compliance Policy Management" {
                description "Authoring, versioning, and attestation of internal compliance policies"
                owner "Chief Compliance Officer"
                maturity "Initial"
                number auto
                attr strategic_value "Medium"
            }
        }

        capability cap_data_privacy "Data Privacy & Protection" {
            description "Customer consent management and data subject rights fulfillment"
            owner "Chief Privacy Officer"
            maturity "Managed"
            number "3.4"
            attr strategic_value "High"

            capability cap_consent_management "Consent Management" {
                description "Capturing, storing, and honouring customer consent preferences across channels"
                owner "Chief Privacy Officer"
                maturity "Managed"
                number auto
                attr strategic_value "High"
            }

            capability cap_data_subject_rights "Data Subject Rights Management" {
                description "Handling access, correction, and erasure requests under privacy regulation"
                owner "Chief Privacy Officer"
                maturity "Defined"
                number auto
                attr strategic_value "Medium"
            }
        }
