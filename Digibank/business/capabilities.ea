                attr strategic_value "High"
            }

            capability cap_exception_management "Exception Management" {
                description "Investigation and resolution of unmatched or breaking reconciliation items"
                owner "Treasury Operations"
                maturity "Defined"
                number auto
                attr strategic_value "Medium"
