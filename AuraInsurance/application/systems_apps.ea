    // Cross-Application Transaction Flows
    app_aura_mobile flows_to app_auto_claims_engine "Submits collision damage photos and driver telematics"
    app_telematics_stream_ingestor flows_to system_aura_event_mesh "Publishes raw kinematics stream (telematics.kinematics.v1)"
    system_aura_event_mesh flows_to app_cep_stream_engine "Streams events for complex accident impact correlation"
    app_auto_claims_engine flows_to app_instant_disbursement_gateway "Triggers sub-second claim settlement payout"
    app_instant_disbursement_gateway flows_to app_policy_ledger_service "Posts claim settlement debit against policy reserves"
    app_policy_ledger_service flows_to app_sap_s4hana_cloud "Transmits daily earned premium journals via OData API"
    app_policy_ledger_service flows_to system_aura_event_mesh "Publishes PolicyBoundEvent and PolicyEndorsementEvent"
    system_aura_event_mesh flows_to app_crm_dynamics365 "Synchronizes policyholder changes to Customer 360"
    app_health_claims_adjudicator flows_to app_sap_s4hana_cloud "Posts aggregated medical provider disbursements"
    app_policy_ledger_service flows_to app_moodys_axis_actuarial "Feeds active policy in-force records for monthly IFRS 17 valuation"
    app_legacy_broker_sftp_v1 migrates_to app_comparative_rater_gateway "Decommissioning legacy batch file transfer in favor of REST API"
    app_member_portal_web flows_to app_health_claims_adjudicator "Submits clinical claims and member inquiries"
    app_member_portal_web flows_to app_life_underwriting_engine "Submits digital life insurance applications"
    app_auto_claims_engine flows_to system_aura_event_mesh "Publishes ClaimSettledEvent and ClaimCreatedEvent"
    app_life_underwriting_engine flows_to system_aura_event_mesh "Publishes LifePolicyIssuedEvent and UnderwritingDecisionEvent"
    app_health_claims_adjudicator flows_to system_aura_event_mesh "Publishes HealthClaimAdjudicatedEvent"
